<?xml version="1.0" encoding="utf-8"?>
<!-- Widget de semana: los próximos 5 días en columnas -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/k_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="12dp">

    <TextView
        android:id="@+id/k_place"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="Madrid"
        android:textColor="#D2BDFF"
        android:textSize="13sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d0_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Hoy"
                android:textColor="#D2BDFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/d0_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_partly_day" />

            <TextView
                android:id="@+id/d0_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="26°"
                android:textColor="#F3ECFF"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/d0_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="15°"
                android:textColor="#A790D6"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/d0_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textColor="#86C9FF"
                android:textSize="15sp"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d1_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Jue"
                android:textColor="#D2BDFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/d1_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_rain" />

            <TextView
                android:id="@+id/d1_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="21°"
                android:textColor="#F3ECFF"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/d1_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="13°"
                android:textColor="#A790D6"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/d1_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="80 %"
                android:textColor="#86C9FF"
                android:textSize="15sp"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d2_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Vie"
                android:textColor="#D2BDFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/d2_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_storm" />

            <TextView
                android:id="@+id/d2_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="19°"
                android:textColor="#F3ECFF"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/d2_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="12°"
                android:textColor="#A790D6"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/d2_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="90 %"
                android:textColor="#86C9FF"
                android:textSize="15sp"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d3_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Sáb"
                android:textColor="#D2BDFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/d3_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_cloudy" />

            <TextView
                android:id="@+id/d3_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="22°"
                android:textColor="#F3ECFF"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/d3_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="12°"
                android:textColor="#A790D6"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/d3_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textColor="#86C9FF"
                android:textSize="15sp"
                android:visibility="invisible" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/d4_name"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="Dom"
                android:textColor="#D2BDFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/d4_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginTop="2dp"
                android:contentDescription="@null"
                android:scaleType="fitCenter"
                android:src="@drawable/wx_clear_day" />

            <TextView
                android:id="@+id/d4_max"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="25°"
                android:textColor="#F3ECFF"
                android:textSize="21sp" />

            <TextView
                android:id="@+id/d4_min"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text="14°"
                android:textColor="#A790D6"
                android:textSize="17sp" />

            <TextView
                android:id="@+id/d4_rain"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/vt323"
                android:includeFontPadding="false"
                android:singleLine="true"
                android:text=""
                android:textColor="#86C9FF"
                android:textSize="15sp"
                android:visibility="invisible" />
        </LinearLayout>

    </LinearLayout>
</LinearLayout>
