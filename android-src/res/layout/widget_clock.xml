<?xml version="1.0" encoding="utf-8"?>
<!-- Widget reloj: hora y fecha (las mueve Android) + cielo y grados -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/c_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingEnd="10dp">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vt323"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#F3ECFF"
            android:textSize="32sp" />

        <TextClock
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/vt323"
            android:format12Hour="EEE d MMM"
            android:format24Hour="EEE d MMM"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#A790D6"
            android:textSize="13sp" />
    </LinearLayout>

    <ImageView
        android:id="@+id/c_icon"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/wx_partly_day" />

    <TextView
        android:id="@+id/c_temp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="2dp"
        android:fontFamily="@font/vt323"
        android:includeFontPadding="false"
        android:singleLine="true"
        android:text="--°"
        android:textColor="#F3ECFF"
        android:textSize="26sp" />
</LinearLayout>
